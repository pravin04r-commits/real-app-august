# apps/api/.env
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — without it, dares fall back to the curated dare_pool
# and AI insights return a graceful "unavailable" response.
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────
# R.E.A.L. — Environment Variables
# Copy to .env (root), apps/web/.env.local and apps/api/.env
# NEVER commit real values.
# ─────────────────────────────────────────────────────────────

# ── PUBLIC (safe in the browser) ──────────────────────────────
# Supabase project URL — Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase anon/public key — client safe, RLS protects the data
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Base URL of the Express API (http://localhost:4000 in dev, Render URL in prod)
NEXT_PUBLIC_API_URL=http://localhost:4000
# Public site URL — used for share links and public profile cards
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── BACKEND ONLY (never expose to the client) ─────────────────
# Same as NEXT_PUBLIC_SUPABASE_URL, read by the Express API
SUPABASE_URL=https://your-project-ref.supabase.co
# Service role key — FULL database access. Backend only. Never in apps/web.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Anthropic API key — Claude powers dares, insights and report cards. Backend only.
ANTHROPIC_API_KEY=sk-ant-your-key
# Supabase JWT secret — Dashboard > Settings > API > JWT Settings
JWT_SECRET=your-supabase-jwt-secret
# Allowed browser origin for CORS
WEB_ORIGIN=http://localhost:3000
# API port
PORT=4000
NODE_ENV=development
